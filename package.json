{
  "type": "module",
  "name": "@its/aura-pivot",
  "version": "2.4.8",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./locales/it.json": "./dist/locales/it.json",
    "./locales/en.json": "./dist/locales/en.json",
    "./locales/*": "./dist/locales/*.json"
  },
  "peerDependencies": {
    "@emotion/react": ">=11.5",
    "@emotion/styled": ">=11.3",
    "@mui/material": ">=9",
    "react": ">=18",
    "react-dom": ">=18",
    "react-intl": "*"
  },
  "dependencies": {
    "@mui/icons-material": "^9.0.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.0.1",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "javascript-obfuscator": "^5.4.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-virtuoso": "^4.18.7",
    "rollup": "^4.60.4",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-obfuscator": "^1.1.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist"
  ],
  "freeplan": {
    "maxBytes": 1048576,
    "infoUrl": "https://aurapivot.web.app"
  },
  "scripts": {
    "build": "rollup -c",
    "build:freeplan": "cross-env FREEPLAN=1 OBFUSCATOR=1 rollup -c",
    "build:freeplan2": "cross-env FREEPLAN=1 OBFUSCATOR=0 rollup -c",
    "prepublish": "npm run build"
  }
}
